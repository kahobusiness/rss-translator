# API 配置（使用 Zenmux 或其他兼容平台）
# 文档: https://zenmux.ai/docs/api/anthropic/create-messages-new.html

# API 密钥（必须）- 从 Zenmux 平台获取
API_KEY=your-zenmux-api-key

# API Base URL（可选，默认为 Zenmux）
# API_BASE_URL=https://zenmux.ai/api/anthropic

# 模型名称（可选，Zenmux 格式）
# MODEL_NAME=anthropic/claude-sonnet-4.5

# 如果使用官方 Anthropic API，取消注释以下配置：
# ANTHROPIC_API_KEY=your-anthropic-api-key
# API_BASE_URL=https://api.anthropic.com
# MODEL_NAME=claude-sonnet-4-20250514

# Cron 任务密钥（可选，用于保护 cron 端点）
CRON_SECRET=your-cron-secret

# OPML 源 URL（可选，默认使用 HN Popular Blogs 2025）
# OPML_URL=https://your-opml-url.com/feeds.opml
