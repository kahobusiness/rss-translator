# API 配置（默认使用 MiniMax Anthropic 兼容端点）

# API 密钥（必须）
API_KEY=your-api-key

# API Base URL（可选，默认 MiniMax）
# API_BASE_URL=https://api.minimaxi.com/anthropic

# 模型名称（可选）
# MODEL_NAME=MiniMax-M2.7

# 如果使用官方 Anthropic API，取消注释以下配置：
# ANTHROPIC_API_KEY=your-anthropic-api-key
# API_BASE_URL=https://api.anthropic.com
# MODEL_NAME=claude-sonnet-4-20250514

# Cron 任务密钥（可选，用于保护 cron 端点）
CRON_SECRET=your-cron-secret

# OPML 源 URL（可选，默认使用 HN Popular Blogs 2025）
# OPML_URL=https://your-opml-url.com/feeds.opml

# 稳定公开订阅域名
SITE_URL=http://localhost:3000

# 强一致私有 Blob（连接当前项目，生产使用 OIDC 或显式私有 token）
# STATE_BLOB_STORE_ID=store_...
# STATE_BLOB_READ_WRITE_TOKEN=...

# 调整翻译策略时递增版本，避免复用旧检查点
TRANSLATION_PROMPT_VERSION=1
