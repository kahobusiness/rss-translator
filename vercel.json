{
  "crons": [
    {
      "path": "/api/cron?batch=0",
      "schedule": "0 */6 * * *"
    },
    {
      "path": "/api/cron?batch=1",
      "schedule": "1 */6 * * *"
    },
    {
      "path": "/api/cron?batch=2",
      "schedule": "2 */6 * * *"
    },
    {
      "path": "/api/cron?batch=3",
      "schedule": "3 */6 * * *"
    },
    {
      "path": "/api/cron?batch=0&work=1",
      "schedule": "5,20,35,50 * * * *"
    },
    {
      "path": "/api/cron?batch=1&work=1",
      "schedule": "6,21,36,51 * * * *"
    },
    {
      "path": "/api/cron?batch=2&work=1",
      "schedule": "7,22,37,52 * * * *"
    },
    {
      "path": "/api/cron?batch=3&work=1",
      "schedule": "8,23,38,53 * * * *"
    }
  ],
  "installCommand": "env -u npm_config_cache_dir -u NPM_CONFIG_CACHE_DIR npm ci",
  "buildCommand": "env -u npm_config_cache_dir -u NPM_CONFIG_CACHE_DIR npm run check"
}
